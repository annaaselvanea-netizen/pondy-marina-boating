rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }

    match /packages/{id}   { allow read: if resource.data.isActive == true || isAdmin(); allow write: if isAdmin(); }
    match /timeSlots/{id}  { allow read: if true; allow write: if isAdmin(); }   // bookedCount changes come from the Admin SDK
    match /gallery/{id}    { allow read: if resource.data.isActive == true || isAdmin(); allow write: if isAdmin(); }
    match /reviews/{id} {
      allow read: if resource.data.status == "approved" || isAdmin();
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment.size() <= 600;
      allow update, delete: if isAdmin();
    }
    match /bookings/{id}  { allow read, update: if isAdmin(); allow create, delete: if false; }
    match /customers/{id} { allow read, write: if isAdmin(); }
    match /users/{uid}    { allow read: if request.auth.uid == uid || isAdmin(); allow write: if isAdmin(); }
    match /settings/{id}  { allow read: if !id.matches('counter-.*') || isAdmin(); allow write: if isAdmin(); }
  }
}